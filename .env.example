# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://payflow:payflow_secret@localhost:5432/payflow_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
# TTL in seconds for wallet balance cache (default: 5 minutes)
REDIS_WALLET_BALANCE_TTL=300
# TTL in seconds for user data cache (default: 10 minutes)
REDIS_USER_TTL=600

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Comma-separated list of brokers
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=payflow-app
KAFKA_GROUP_ID=payflow-consumers
# Dead-letter topic suffix
KAFKA_DLT_SUFFIX=.dlq
# Outbox poll interval in milliseconds
OUTBOX_POLL_INTERVAL_MS=5000
# Maximum retry attempts before sending to DLT
OUTBOX_MAX_RETRIES=3

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a cryptographically random value in production
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Idempotency ──────────────────────────────────────────────────────────────
# How long to retain idempotency records (in seconds). Default: 24 hours
IDEMPOTENCY_TTL_SECONDS=86400
